---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSession, requireAuth } from '../../lib/auth';
import { db } from '../../db';
import { clients } from '../../db/schema';
import { desc } from 'drizzle-orm';

const session = await getSession(Astro.cookies);
try {
  requireAuth(session, ['admin', 'editor']);
} catch {
  return Astro.redirect('/admin/login');
}

const rows = await db.query.clients.findMany({
  orderBy: [desc(clients.createdAt)],
  limit: 200,
});
---

<BaseLayout title="Admin · Clientes">
  <main class="min-h-screen px-5 py-24" style="background:#0d0d0b; color:#f0ede6;">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-serif">Clientes</h1>
        <a href="/admin" class="text-[#8B6F47] hover:underline text-sm">← Voltar ao dashboard</a>
      </div>

      <form id="client-form" class="mb-12 p-6 rounded-lg border border-[#8B6F47]/30" style="background:#1a1915;">
        <h2 class="text-xl font-serif mb-4">Novo cliente</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
          <div>
            <label class="block text-sm mb-1 opacity-70">Nome *</label>
            <input name="name" required class="w-full px-4 py-2 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 outline-none focus:border-[#8B6F47]" />
          </div>
          <div>
            <label class="block text-sm mb-1 opacity-70">E-mail</label>
            <input name="email" type="email" class="w-full px-4 py-2 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 outline-none focus:border-[#8B6F47]" />
          </div>
          <div>
            <label class="block text-sm mb-1 opacity-70">Telefone</label>
            <input name="phone" class="w-full px-4 py-2 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 outline-none focus:border-[#8B6F47]" />
          </div>
        </div>
        <div class="mb-5">
          <label class="block text-sm mb-1 opacity-70">Observações (sensível, criptografado)</label>
          <textarea name="notes" rows="3" class="w-full px-4 py-2 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 outline-none focus:border-[#8B6F47]"></textarea>
        </div>
        <button type="submit" class="px-6 py-2 rounded bg-[#8B6F47] text-[#0d0d0b] font-medium">Salvar cliente</button>
        <p id="form-msg" class="mt-3 text-sm hidden"></p>
      </form>

      <div class="space-y-3">
        {rows.length === 0 && <p class="opacity-60">Nenhum cliente cadastrado.</p>}
        {rows.map((c) => (
          <div class="p-4 rounded-lg border border-[#8B6F47]/30 flex items-center justify-between" style="background:#1a1915;">
            <div>
              <p class="font-serif">{c.name}</p>
              <p class="text-sm opacity-60">{c.email} {c.phone && `· ${c.phone}`}</p>
            </div>
            <a href={`/admin/sessions?clientId=${c.id}`} class="text-sm text-[#8B6F47] hover:underline">Criar sessão →</a>
          </div>
        ))}
      </div>
    </div>
  </main>

  <script>
    const form = document.getElementById('client-form') as HTMLFormElement;
    const msg = document.getElementById('form-msg') as HTMLParagraphElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const res = await fetch('/api/admin/clients', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (res.ok && data.success) {
        msg.textContent = 'Cliente criado com sucesso!';
        msg.className = 'mt-3 text-sm text-green-400';
        form.reset();
        setTimeout(() => window.location.reload(), 800);
      } else {
        msg.textContent = data.error || 'Erro ao salvar.';
        msg.className = 'mt-3 text-sm text-red-400';
      }
      msg.classList.remove('hidden');
    });
  </script>
</BaseLayout>
