---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSession, requireAuth } from '../../../lib/auth';
import { db } from '../../../db';
import { sessions, files } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const session = await getSession(Astro.cookies);
try {
  requireAuth(session, ['admin', 'editor']);
} catch {
  return Astro.redirect('/admin/login');
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin');

const sessionRow = await db.query.sessions.findFirst({
  where: eq(sessions.id, id),
});
if (!sessionRow) return Astro.redirect('/admin');

const filesRows = await db.query.files.findMany({
  where: eq(files.sessionId, id),
  orderBy: [desc(files.createdAt)],
});
---

<BaseLayout title={`Admin · ${sessionRow.title}`}>
  <main class="min-h-screen px-5 py-24" style="background:#0d0d0b; color:#f0ede6;">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-serif">{sessionRow.title}</h1>
        <a href="/admin/clients" class="text-[#8B6F47] hover:underline text-sm">← Voltar</a>
      </div>

      <div class="mb-8 p-6 rounded-lg border border-[#8B6F47]/30" style="background:#1a1915;">
        <p class="text-sm opacity-70 mb-2">
          {sessionRow.type} {sessionRow.date && `· ${sessionRow.date}`} · {sessionRow.status}
        </p>
        <a href={`/galeria/${sessionRow.id}`} class="text-[#8B6F47] hover:underline text-sm">Link público da galeria →</a>
      </div>

      <div class="mb-12 p-6 rounded-lg border border-[#8B6F47]/30" style="background:#1a1915;">
        <h2 class="text-xl font-serif mb-4">Upload de arquivos</h2>
        <form id="upload-form" data-endpoint="/api/admin/upload" data-msg="upload-msg" data-ok="Arquivo enviado!" data-envio="form" data-reload="600" class="flex flex-col md:flex-row gap-4 items-start">
          <input type="hidden" name="sessionId" value={sessionRow.id} />
          <input type="file" name="file" required accept="image/*,.pdf" class="text-sm" />
          <button type="submit" class="px-4 py-2 rounded bg-[#8B6F47] text-[#0d0d0b] text-sm font-medium">Enviar</button>
        </form>
        <p id="upload-msg" class="mt-3 text-sm hidden"></p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {filesRows.map((f) => (
          <div class="rounded border border-[#8B6F47]/30 overflow-hidden" style="background:#1a1915;">
            {f.mimeType?.startsWith('image/') ? (
              <img src={`/api/uploads/${f.id}`} alt={f.originalName} class="w-full h-40 object-cover" />
            ) : (
              <div class="h-40 flex items-center justify-center text-sm opacity-60">PDF</div>
            )}
            <p class="p-3 text-xs truncate opacity-70">{f.originalName}</p>
          </div>
        ))}
        {filesRows.length === 0 && <p class="opacity-60 col-span-full">Nenhum arquivo enviado.</p>}
      </div>
    </div>
  </main>

  {/* is:inline + src: sem isso o Astro embute o codigo no HTML e a CSP
      (script-src 'self') bloqueia — os formularios ficam mudos. */}
  <script is:inline src="/assets/js/admin-forms.js" defer></script>
</BaseLayout>
