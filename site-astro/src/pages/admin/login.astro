---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSession } from '../../lib/auth';

const session = await getSession(Astro.cookies);
if (session) {
  return Astro.redirect('/admin');
}
---

<BaseLayout title="Admin · Login">
  <main class="min-h-screen flex items-center justify-center px-5" style="background:#0d0d0b;">
    <div class="w-full max-w-md p-8 rounded-lg border border-[#8B6F47]/30" style="background:#1a1915;">
      <h1 class="text-2xl font-serif mb-6 text-center" style="color:#f0ede6;">Área Administrativa</h1>

      <form id="login-form" class="space-y-5">
        <div>
          <label class="block text-sm mb-1" style="color:rgba(240,237,230,0.7);">E-mail</label>
          <input
            type="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 text-[#f0ede6] focus:border-[#8B6F47] outline-none"
          />
        </div>
        <div>
          <label class="block text-sm mb-1" style="color:rgba(240,237,230,0.7);">Senha</label>
          <input
            type="password"
            name="password"
            required
            minlength="8"
            class="w-full px-4 py-3 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 text-[#f0ede6] focus:border-[#8B6F47] outline-none"
          />
        </div>
        {/* escondido até o servidor dizer que esta conta tem 2FA ligado */}
        <div id="campo-totp" class="hidden">
          <label class="block text-sm mb-1" style="color:rgba(240,237,230,0.7);">
            Código do aplicativo
          </label>
          <input
            type="text"
            name="totp"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]*"
            maxlength="9"
            placeholder="000000"
            class="w-full px-4 py-3 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 text-[#f0ede6] text-center tracking-[0.4em] focus:border-[#8B6F47] outline-none"
          />
          <p class="mt-1 text-xs" style="color:rgba(240,237,230,0.45);">
            6 dígitos do autenticador, ou um código de recuperação.
          </p>
        </div>

        <button
          type="submit"
          class="w-full py-3 rounded font-medium tracking-wider uppercase text-sm transition-colors"
          style="background:#8B6F47; color:#0d0d0b;"
        >
          Entrar
        </button>
      </form>

      <p id="login-error" class="mt-4 text-center text-sm text-red-400 hidden"></p>
    </div>
  </main>

  {/* is:inline + src: sem isso o Astro embute o codigo no HTML e a CSP
      (script-src 'self') bloqueia — o formulario para de enviar. */}
  <script is:inline src="/assets/js/admin-login.js" defer></script>
</BaseLayout>
