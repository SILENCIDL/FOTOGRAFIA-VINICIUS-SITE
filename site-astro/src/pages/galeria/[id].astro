---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db';
import { sessions, files } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { hasGalleryAccess } from '../../lib/galleryAuth';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const sessionRow = await db.query.sessions.findFirst({
  where: eq(sessions.id, id),
});

const error = Astro.url.searchParams.get('error');
let filesRows: typeof files.$inferSelect[] = [];
let unlocked = false;

// galeria expirada volta a ser cofre fechado, mesmo com token na mão
const expirada = !!sessionRow?.expiresAt && new Date(sessionRow.expiresAt) < new Date();

if (sessionRow && !expirada) {
  unlocked = await hasGalleryAccess(Astro.cookies, id);
  if (unlocked) {
    filesRows = await db.query.files.findMany({
      where: eq(files.sessionId, id),
      orderBy: [desc(files.createdAt)],
    });
  }
}
---

<BaseLayout title={sessionRow ? `Galeria · ${sessionRow.title}` : 'Galeria'}>
  <main class="min-h-screen px-5 py-24" style="background:#0d0d0b; color:#f0ede6;">
    <div class="max-w-6xl mx-auto text-center">
      {!sessionRow && (
        <div>
          <h1 class="text-3xl font-serif mb-4">Galeria não encontrada</h1>
          <a href="/" class="text-[#8B6F47] hover:underline">Voltar ao início</a>
        </div>
      )}

      {sessionRow && !unlocked && (
        <div class="max-w-md mx-auto p-8 rounded-lg border border-[#8B6F47]/30" style="background:#1a1915;">
          <h1 class="text-2xl font-serif mb-2">{sessionRow.title}</h1>
          <p class="text-sm opacity-70 mb-6">Esta galeria é privada. Digite a senha para acessar.</p>
          <form id="gallery-form" class="space-y-4">
            <input type="hidden" name="sessionId" value={id} />
            <input
              type="password"
              name="password"
              required
              placeholder="Senha da galeria"
              class="w-full px-4 py-3 rounded bg-[#0d0d0b] border border-[#8B6F47]/40 text-center outline-none focus:border-[#8B6F47]"
            />
            <button type="submit" class="w-full py-3 rounded bg-[#8B6F47] text-[#0d0d0b] font-medium">Acessar</button>
          </form>
          {error && <p class="mt-4 text-sm text-red-400">{error}</p>}
        </div>
      )}

      {sessionRow && unlocked && (
        <div>
          <h1 class="text-3xl font-serif mb-8">{sessionRow.title}</h1>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {filesRows.map((f) => (
              <div class="rounded border border-[#8B6F47]/30 overflow-hidden" style="background:#1a1915;">
                {f.mimeType?.startsWith('image/') ? (
                  <img src={`/api/uploads/${f.id}`} alt={f.originalName} class="w-full h-64 object-cover" />
                ) : (
                  <a href={`/api/uploads/${f.id}`} class="h-64 flex items-center justify-center text-sm text-[#8B6F47] hover:underline">
                    Baixar {f.originalName}
                  </a>
                )}
              </div>
            ))}
          </div>
          {filesRows.length === 0 && <p class="opacity-60 mt-12">Nenhum arquivo disponível ainda.</p>}
        </div>
      )}
    </div>
  </main>

  {/* is:inline + src: sem isso o Astro embute o código no HTML e a CSP
      (script-src 'self') bloqueia — o botão de senha para de funcionar. */}
  <script is:inline src="/assets/js/galeria-acesso.js" defer></script>
</BaseLayout>
