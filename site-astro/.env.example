# Ambiente
NODE_ENV=development
PORT=4321

# Banco de dados PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinicius_site
DATABASE_SSL=false

# Segurança (gerar valores fortes em produção, mínimo 32 caracteres)
# JWT_SECRET assina a sessão do admin E o token da galeria do cliente:
# trocá-la desloga todo mundo e invalida as galerias já abertas.
JWT_SECRET=substitua_por_uma_chave_forte_de_64_caracteres_ou_mais
# APP_ENCRYPTION_KEY criptografa as notas de cliente e gera o pseudônimo de IP
# do log de auditoria. Trocá-la torna as notas antigas ilegíveis.
APP_ENCRYPTION_KEY=substitua_por_outra_chave_forte_de_64_caracteres_ou_mais

# Ligar SOMENTE quando o app estiver atrás de um proxy que reescreve
# x-forwarded-for (Netlify, Vercel, nginx). Ligado sem proxy na frente, o
# visitante escolhe o próprio IP e escapa do rate limit à vontade.
TRUST_PROXY=false

# Upload de arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf

# Domínio
PUBLIC_SITE_URL=http://localhost:4321
