{
  "redirects": [
    { "source": "/portfolio.html", "destination": "/pages/portfolio.html", "permanent": true },
    { "source": "/casamentos.html", "destination": "/pages/casamentos.html", "permanent": true },
    { "source": "/paisagem.html", "destination": "/pages/paisagem.html", "permanent": true },
    { "source": "/aventura.html", "destination": "/pages/aventura.html", "permanent": true },
    { "source": "/rua.html", "destination": "/pages/rua.html", "permanent": true },
    { "source": "/olhar.html", "destination": "/pages/olhar.html", "permanent": true },
    { "source": "/casamento-bianca-e-donizete.html", "destination": "/pages/casamento-bianca-e-donizete.html", "permanent": true },
    { "source": "/casamento-miellem-e-aleft.html", "destination": "/pages/casamento-miellem-e-aleft.html", "permanent": true },
    { "source": "/casamento-pamela-e-juliano.html", "destination": "/pages/casamento-pamela-e-juliano.html", "permanent": true },
    { "source": "/casamento-patricia-e-marcos.html", "destination": "/pages/casamento-patricia-e-marcos.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
